NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Optional TURN server for reliable WebRTC calls across restrictive NAT/firewalls.
# Keep TURN credentials temporary/limited where possible; never use admin credentials here.
NEXT_PUBLIC_TURN_URL=turn:your-turn-host.example:3478
NEXT_PUBLIC_TURN_USERNAME=your-turn-username
NEXT_PUBLIC_TURN_CREDENTIAL=your-turn-credential
